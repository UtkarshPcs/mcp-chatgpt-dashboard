                  "name": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "enum": [
                      "School",
                      "Coaching"
                    ]
                  },
                  "chapterIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "date",
                  "location",
                  "chapterIds"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
