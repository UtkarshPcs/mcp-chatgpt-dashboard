    },
    "/api/mcp/tools/upsert_exam": {
      "post": {
        "operationId": "upsert_exam",
        "summary": "upsert_exam",
        "description": "Creates or updates an exam record with chapter IDs.",
        "requestBody": {
          "required": true,
