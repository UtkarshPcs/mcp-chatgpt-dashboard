                  },
                  "id": {
                    "type": "string",
                    "description": "ID of the time log entry to delete (required for 'delete')"
                  },
                  "limit": {
                    "type": "number",
                    "description": "Maximum number of entries to return on 'list'"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
