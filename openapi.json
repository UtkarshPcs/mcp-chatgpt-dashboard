    "/api/mcp/tools/update_ai_recommendation": {
      "post": {
        "operationId": "update_ai_recommendation",
        "summary": "update_ai_recommendation",
        "description": "Updates the central AI Study Recommendation card. You MUST provide the correct chapterId and subjectId. If you do not know them, call get_syllabus_state first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chapterId": {
                    "type": "string"
                  },
                  "subjectId": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "estimatedTime": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  }
                },
                "required": [
                  "chapterId",
                  "subjectId",
                  "reason",
                  "estimatedTime",
                  "priority"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/record_chapter_revision": {
      "post": {
        "operationId": "record_chapter_revision",
        "summary": "record_chapter_revision",
        "description": "Updates a chapter's revision dates. ALWAYS use this tool when the user completes a revision, rather than updating notes. You MUST calculate the nextRevisionDate based on spaced repetition (e.g., 1st revision = +1 day, 2nd = +3 days, 3rd = +7 days).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "lastRevisionDate": {
                    "type": "string"
                  },
                  "nextRevisionDate": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "lastRevisionDate",
                  "nextRevisionDate"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/get_delayed_revisions": {
      "post": {
        "operationId": "get_delayed_revisions",
        "summary": "get_delayed_revisions",
        "description": "Retrieves all chapters that have a scheduled revision date that has already passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/mark_revision_complete": {
      "post": {
        "operationId": "mark_revision_complete",
        "summary": "mark_revision_complete",
        "description": "Marks a chapter's pending revision as completed. It increments the revision count (max 3), updates lastRevisionDate to today, and clears nextRevisionDate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/manage_subject_template": {
      "post": {
        "operationId": "manage_subject_template",
        "summary": "manage_subject_template",
        "description": "Creates, updates, or reorders the task framework for a specific subject. Overwrites the existing template. Provide an array of tasks with names, weights (must sum to 100), and order.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subjectId": {
                    "type": "string",
                    "description": "The unique ID of the subject to manage (e.g., 'physics_12')"
                  },
                  "tasks": {
                    "type": "array",
                    "description": "The complete array of tasks that make up the framework for this subject",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "A unique string ID for the task (e.g., 'physics_lecture')"
                        },
                        "name": {
                          "type": "string",
                          "description": "Display name (e.g., 'Watch Lecture')"
                        },
                        "weight": {
                          "type": "number",
                          "description": "Percentage weight of this task (0-100)"
                        },
                        "order": {
                          "type": "number",
                          "description": "Sorting order"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "weight",
                        "order"
                      ]
                    }
                  }
                },
                "required": [
                  "subjectId",
                  "tasks"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/update_chapter_task": {
      "post": {
        "operationId": "update_chapter_task",
        "summary": "update_chapter_task",
        "description": "Marks a specific task as completed or not_started for a particular chapter.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chapterId": {
                    "type": "string",
                    "description": "The unique ID of the chapter to update"
                  },
                  "taskId": {
                    "type": "string",
                    "description": "The ID of the task from the subject's task template"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "not_started"
                    ],
                    "description": "The new completion status ('completed' or 'not_started')"
                  }
                },
                "required": [
                  "chapterId",
                  "taskId",
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
