              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/manage_mistake_log": {
      "post": {
        "operationId": "manage_mistake_log",
        "summary": "manage_mistake_log",
        "description": "Logs and manages weak topics and mistake entries for specific chapters. Allows adding mistakes (topics, question context, notes), retrieving weak/unresolved topics to target for revision, updating mistake status ('weak' vs 'resolved') or details, and deleting entries.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "delete",
                      "get"
                    ],
                    "description": "The action to perform: 'add', 'update', 'delete', or 'get'"
                  },
                  "id": {
                    "type": "string",
                    "description": "ID of the mistake log entry (required for 'update' and 'delete')"
                  },
                  "chapterId": {
                    "type": "string",
                    "description": "ID of the chapter (required for 'add', optional filter for 'get')"
                  },
                  "subjectId": {
                    "type": "string",
                    "description": "ID of the subject (optional filter for 'get')"
                  },
                  "topic": {
                    "type": "string",
                    "description": "Specific concept or topic where the mistake occurred (required for 'add')"
                  },
                  "question": {
                    "type": "string",
                    "description": "Simple text entry of the question or problem context"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Explanation of why the mistake happened, concept gap, or remedial note"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "weak",
                      "resolved",
                      "all"
                    ],
                    "description": "Status to set on 'add'/'update' ('weak' or 'resolved', defaults to 'weak'), or filter for 'get' ('weak', 'resolved', or 'all', defaults to 'weak')"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/log_task_time": {
      "post": {
        "operationId": "log_task_time",
        "summary": "log_task_time",
        "description": "Logs the time spent on a specific task within a chapter. Records subject, chapter, task, duration in minutes, optional date, optional start/end time window (e.g. 4:30 PM to 5:30 PM), timestamp, and optional notes. If start and end times are provided, duration is calculated automatically if omitted. Preserves historical records across repeated sessions without overwriting previous entries. Optionally marks the chapter task as completed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chapterId": {
                    "type": "string",
                    "description": "The unique ID of the chapter being studied"
                  },
                  "taskId": {
                    "type": "string",
                    "description": "The ID of the task (from framework or 'revision' or custom)"
                  },
                  "timeSpentMinutes": {
                    "type": "number",
                    "description": "Duration spent studying in minutes (optional if startTime and endTime are provided)"
                  },
                  "date": {
                    "type": "string",
                    "description": "Session date in YYYY-MM-DD format (optional, defaults to current date)"
                  },
                  "startTime": {
                    "type": "string",
                    "description": "Session start time e.g. '16:30' or '4:30 PM' (optional)"
                  },
                  "endTime": {
                    "type": "string",
                    "description": "Session end time e.g. '17:30' or '5:30 PM' (optional)"
                  },
                  "subjectId": {
                    "type": "string",
                    "description": "The unique ID of the subject (optional)"
                  },
                  "taskName": {
                    "type": "string",
                    "description": "Human-readable display name for this task (optional)"
                  },
                  "timestamp": {
                    "type": "string",
                    "description": "ISO date string for when the session took place (optional)"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Optional notes on what was accomplished"
                  },
                  "markTaskCompleted": {
                    "type": "boolean",
                    "description": "If true, also marks chapter task as completed"
                  }
                },
                "required": [
                  "chapterId",
                  "taskId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/get_study_time_analytics": {
      "post": {
        "operationId": "get_study_time_analytics",
        "summary": "get_study_time_analytics",
        "description": "Calculates study time statistics from logged data. Returns total time spent, daily, weekly, and monthly periodic study hours, average time per session, empirical average time required to complete or revise each task type across multiple sessions, time-consuming chapter rankings, and recent session logs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subjectId": {
                    "type": "string",
                    "description": "Optional filter by subject ID"
                  },
                  "chapterId": {
                    "type": "string",
                    "description": "Optional filter by chapter ID"
                  },
                  "taskId": {
                    "type": "string",
                    "description": "Optional filter by task ID or task type"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/tools/manage_time_logs": {
      "post": {
        "operationId": "manage_time_logs",
        "summary": "manage_time_logs",
        "description": "Lists or deletes individual study time records.",
